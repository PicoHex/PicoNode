<Project>
  <!-- ═══════════════════════════════════════════════════════
       Central Package Management — single source of truth
       for all NuGet dependency versions in this solution.
       ═══════════════════════════════════════════════════════ -->

  <ItemGroup>
    <!-- PicoHex ecosystem -->
    <PackageVersion Include="PicoCfg" Version="2026.9.3" />
    <PackageVersion Include="PicoCfg.Abs" Version="2026.9.3" />
    <PackageVersion Include="PicoDI" Version="2026.9.3" />
    <PackageVersion Include="PicoDI.Abs" Version="2026.9.3" />
    <PackageVersion Include="PicoJetson" Version="2026.9.14" />
    <PackageVersion Include="PicoLog" Version="2026.9.3" />
    <PackageVersion Include="PicoLog.Abs" Version="2026.9.3" />

    <!-- PicoNode internal (conditional package refs for NuGet publish) -->
    <PackageVersion Include="PicoNode" Version="$(Version)" />
    <PackageVersion Include="PicoNode.Abs" Version="$(Version)" />
    <PackageVersion Include="PicoNode.Http" Version="$(Version)" />
    <PackageVersion Include="PicoNode.Web.Session.Abs" Version="$(Version)" />
    <PackageVersion Include="PicoNode.Web" Version="$(Version)" />

    <!-- .NET / Roslyn infrastructure -->
    <!-- Microsoft.CodeAnalysis.CSharp stays on the SDK 10.0.400 Roslyn band;
         analyzers referencing a newer Roslyn than the compiler fail to load. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />

    <!-- Testing -->
    <PackageVersion Include="PicoBench" Version="2026.3.0" />
    <PackageVersion Include="TUnit" Version="1.68.0" />
  </ItemGroup>
</Project>
