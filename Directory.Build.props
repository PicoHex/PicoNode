<Project>
  <!-- ═══════════════════════════════════════════════════════
       PicoNode shared build properties
       ═══════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- Default version for local / non-CI builds -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <!-- Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- CPM refuses floating PackageVersion items (NU1011) unless this is
         on; the float is deliberate and bounded to the y segment. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>

    <!-- Floating y-segments (see Directory.Packages.props) resolve to the
         newest matching version on every restore, which makes a restore
         non-reproducible on its own. The lock files pin what actually
         resolved; CI restores with RestoreLockedMode=true so a dependency
         only moves when a lock file moves (deps-refresh.yml re-evaluates). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Deterministic builds when CI=true -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages for NuGet.org debugging experience -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Default: use project references for local dev -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>

    <!-- Default: don't pack unless opted in -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <!-- PicoJetson (≥ 2026.4) generates unsafe code paths for anonymous-type
         serialization; its analyzer requires the flag in consuming projects. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       SourceLink — enabled only for packable projects
       ═══════════════════════════════════════════════════════ -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════
       AOT tiers (see csproj-format skill "AOT Strategy Centralization"):
       minimal    — default. PublishAot + TrimMode only (Tests).
       aggressive — Samples/Benchmarks. Size levers live in
                    Directory.Build.targets (evaluated AFTER the project file,
                    so csproj-level <AotOptimizationLevel> declarations work).
       NOTE: classic Ilc* MSBuild properties were removed in .NET 10 SDK
       (>= 10.0.400) and are silently ignored — ILC uses its built-in
       defaults. Replacements: StackTraceSupport / UseSystemResourceKeys /
       InvariantGlobalization (app-level).
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <AotOptimizationLevel Condition="'$(AotOptimizationLevel)' == ''">minimal</AotOptimizationLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotOptimizationLevel)' == 'minimal'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <TrimMode Condition="'$(TrimMode)' == ''">full</TrimMode>
  </PropertyGroup>

  <!-- netstandard2.0 must NEVER AOT — the guard lives in
       Directory.Build.targets (evaluated where TargetFrameworkIdentifier is
       known; Directory.Build.props evaluates before the TFM is resolved). -->
</Project>
