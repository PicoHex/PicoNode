<Project>
  <!-- ═══════════════════════════════════════════════════════
       PicoNode shared build properties
       ═══════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- Default version for local / non-CI builds -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <!-- Central Package Management. All three CPM switches
         (ManagePackageVersionsCentrally, CentralPackageFloatingVersionsEnabled
         and CentralPackageTransitivePinningEnabled) are declared exactly once,
         in Directory.Packages.props, next to the versions they govern, as in
         PicoActor / PicoSerDe / PicoUI. This file holds the mechanism only. -->

    <!-- packages.lock.json is a RECORD, not a pin, and this switch is what writes it.

         Floating dependencies (see Directory.Packages.props) resolve to the newest
         matching version inside their declared band on every restore. The lock file
         beside each project records what THIS restore resolved: nothing is pinned
         against it, CI does not replay it, and .gitignore keeps it out of the tree, so
         `dotnet publish` writing RID-specific entries into it cannot dirty a release.
         "Which versions did that build use" is answered by the `resolved-versions`
         artifact ci.yml uploads (one per leg).

         Deliberately still TRUE: with this off NuGet neither writes nor reads a lock
         file, so a restore resolves silently and leaves nothing to inspect. Untracked
         is not off. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Deterministic builds when CI=true -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages for NuGet.org debugging experience -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Default: use project references for local dev -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>

    <!-- Default: don't pack unless opted in -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <!-- PicoJetson (≥ 2026.4) generates unsafe code paths for anonymous-type
         serialization; its analyzer requires the flag in consuming projects. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       SourceLink — enabled only for packable projects
       ═══════════════════════════════════════════════════════ -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════
       AOT tiers (see csproj-format skill "AOT Strategy Centralization"):
       minimal    — default. PublishAot + TrimMode only (Tests).
       aggressive — Samples/Benchmarks. Size levers live in
                    Directory.Build.targets (evaluated AFTER the project file,
                    so csproj-level <AotOptimizationLevel> declarations work).
       NOTE: classic Ilc* MSBuild properties were removed in .NET 10 SDK
       (>= 10.0.400) and are silently ignored — ILC uses its built-in
       defaults. Replacements: StackTraceSupport / UseSystemResourceKeys /
       InvariantGlobalization (app-level).
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <AotOptimizationLevel Condition="'$(AotOptimizationLevel)' == ''">minimal</AotOptimizationLevel>
  </PropertyGroup>

  <!-- Restore must be RID-neutral, or the lock files cannot be host-independent.
       PublishAot=true makes the SDK infer PublishRuntimeIdentifier =
       $(NETCoreSdkPortableRuntimeIdentifier) and append it to RuntimeIdentifiers
       AT RESTORE TIME (Microsoft.NET.RuntimeIdentifierInference.targets), which
       bakes a `net10.0/<host-rid>` section into every executable's
       packages.lock.json — tests included, because the minimal AOT tier sets
       PublishAot. A lock generated on win-x64 then fails NU1004 on the
       linux/osx CI legs ("the project's runtime identifiers have changed"), and
       the other way round, so the committed lock would record who last refreshed
       it instead of what was resolved. Disabling the default keeps
       RuntimeIdentifiers empty unless a RID is asked for: every `dotnet publish`
       in this repo already passes an explicit -r (ci.yml's three AOT steps,
       scripts/test-aot-publish.ps1), and a publish that passes -r still restores
       that RID's assets. A publish WITHOUT -r on an AOT project now needs the -r
       it always implied. -->
  <PropertyGroup>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotOptimizationLevel)' == 'minimal'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <TrimMode Condition="'$(TrimMode)' == ''">full</TrimMode>
  </PropertyGroup>

  <!-- netstandard2.0 must NEVER AOT — the guard lives in
       Directory.Build.targets (evaluated where TargetFrameworkIdentifier is
       known; Directory.Build.props evaluates before the TFM is resolved). -->

  <!-- ═══════════════════════════════════════════════════════
       NuGet package icon (the PicoHex family logo)

       The two halves below are a pair and must stay together: PackageIcon
       names the entry inside the package, the None item actually puts the
       file there at the package root. Remove either one and `dotnet pack`
       fails with NU5046 (the icon file does not exist in the package).

       $(MSBuildThisFileDirectory) resolves against THIS file, so the icon is
       always the repository root icon.png, no matter how deep the packing
       project sits. Guarding the item on IsPackable is safe in a props file:
       MSBuild evaluates every item in a pass after every property, so the
       condition already sees the value the csproj body declares.

       PNG here and not the SVG the READMEs use: PackageIcon accepts only PNG
       and JPG. The vector logo lives at assets/picohex.svg.

       (No literal double hyphen appears above: XML comments may not contain
       one, and a props file that does not parse loses every property it
       declares, which surfaces as NU1015, not as a syntax error.)
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
