<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PicoJsonRpc</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>PicoJsonRpc</PackageId>
    <Description>PicoJsonRpc — AOT-first, PicoJetson-serialized JSON-RPC 2.0 protocol core (NDJSON framing, process lifecycle, id-routed multiplexed client). PicoHex stack only.</Description>
    <PackageTags>PicoHex;JsonRpc;JSON-RPC;AOT;NDJSON;PicoJetson</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoJetson" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
