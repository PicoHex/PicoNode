<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AotOptimizationLevel>aggressive</AotOptimizationLevel>
    <TrimMode>full</TrimMode>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\PicoWeb.Samples.Abs\PicoWeb.Samples.Abs.csproj" />
    <ProjectReference Include="..\..\src\Web\PicoWeb\PicoWeb.csproj" />

    <!--
      Source generators: ProjectReference does NOT propagate <Analyzer> items,
      so reference the Gen projects directly with OutputItemType=Analyzer.
      This is the standard pattern — see PicoJetson's sample for the same approach.
      NuGet consumers get analyzers automatically via buildTransitive/PicoWeb.props.
    -->
    <ProjectReference
      Include="..\..\src\Web\Controllers.Gen\Controllers.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\src\Web\PicoWeb.Gen\PicoWeb.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PicoDI" />
    <PackageReference Include="PicoLog" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
