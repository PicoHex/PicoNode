<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The README code samples, in the only form that cannot rot: compiled.

    Each `#region readme:<name>` below is mirrored verbatim into all ten READMEs, and
    tests/PicoNode.Docs.Tests fails when a README drifts from its region. A sample that stops
    compiling fails this project's build (which Docs.Tests references), so the doc cannot publish
    code that does not build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logging sample wires a real PicoLog sink; the sink types live in PicoLog, which
         the transport only references through PicoLog.Abs. -->
    <PackageReference Include="PicoLog" />
    <ProjectReference Include="..\..\src\Network\PicoNode\PicoNode.csproj" />
    <!-- The built-in middleware samples (compression, static files) need the web layer. -->
    <ProjectReference Include="..\..\src\Web\PicoNode.Web\PicoNode.Web.csproj" />
  </ItemGroup>
</Project>
